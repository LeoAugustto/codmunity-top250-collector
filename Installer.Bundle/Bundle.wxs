<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">
  <Bundle Name="CODMunity Top 250 Collector"
          Manufacturer="CODMunity"
        Version="0.1.27"
          UpgradeCode="{4D7781F4-570A-42A4-9378-F1D97C01B4C3}"
          IconSourceFile="$(var.ProjectDir)..\CODMunityTop250Collector.App\Assets\codmunity-logo.ico">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense"
                                                LicenseUrl=""
                                                ThemeFile="$(var.ProjectDir)Assets\CODMunityTheme.xml"
                                                LocalizationFile="$(var.ProjectDir)Assets\CODMunityTheme.wxl"
                                                LogoFile="$(var.ProjectDir)..\CODMunityTop250Collector.App\Assets\codmunity-logo.png"
                                                LaunchTarget="[LocalAppDataFolder]Programs\CODMunity Top 250 Collector\CODMunityTop250Collector.exe"
                                                LaunchWorkingFolder="[LocalAppDataFolder]Programs\CODMunity Top 250 Collector" />
    </BootstrapperApplication>

    <netfx:DotNetCoreSearch Id="DotNetDesktopRuntime8X64"
                            Variable="DOTNET_DESKTOP_RUNTIME_8_X64"
                            RuntimeType="desktop"
                            Platform="x64"
                            MajorVersion="8" />

    <Chain>
      <ExePackage Id="DotNetDesktopRuntime8X64Package"
                  DisplayName="Microsoft .NET 8 Desktop Runtime (x64)"
                  Description="Required to run CODMunity Top 250 Collector."
                  DetectCondition="DOTNET_DESKTOP_RUNTIME_8_X64 &gt;= v8.0.31"
                  InstallArguments="/install /quiet /norestart"
                  RepairArguments="/repair /quiet /norestart"
                  PerMachine="yes"
                  Permanent="yes"
                  Cache="remove"
                  Protocol="burn"
                  Vital="yes">
        <ExePackagePayload Id="DotNetDesktopRuntime8X64Payload"
                           Name="windowsdesktop-runtime-8.0.31-win-x64.exe"
                           DownloadUrl="https://builds.dotnet.microsoft.com/dotnet/WindowsDesktop/8.0.31/windowsdesktop-runtime-8.0.31-win-x64.exe"
                           Hash="605189223CF0A64BFB5453520B794D1D386A97C7E65E3944FEAF9214DB1A8B247F66C569265AEF4204447BAF5B5FF19559C323D887E1318F17DEB28A5AF0FA12"
                           Size="58715896"
                           Version="8.0.31"
                           ProductName="Microsoft .NET 8 Desktop Runtime (x64)" />
      </ExePackage>
      <MsiPackage Id="CODMunityTop250CollectorMsi"
                  SourceFile="$(var.ProjectDir)..\dist\msi\CODMunityTop250Collector-0.1.27-alpha-win-x64.msi"
                  Vital="yes"
                  Visible="no" />
    </Chain>
  </Bundle>
</Wix>
