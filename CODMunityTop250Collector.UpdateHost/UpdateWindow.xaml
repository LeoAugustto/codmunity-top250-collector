<Window x:Class="CODMunityTop250Collector.UpdateHost.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updating CODMunity" Width="380" Height="210" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True"
        Background="#151D1F" Foreground="#FFFFFF" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Border Background="#151D1F" BorderBrush="#394446" BorderThickness="1" CornerRadius="8" Padding="24">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/codmunity-logo.png" Width="32" Height="32" Margin="0,0,10,0" />
                <StackPanel VerticalAlignment="Center"><TextBlock Text="CODMunity" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Updating CODMunity" Foreground="#B9C4C5" FontSize="12" /></StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="2" x:Name="StatusText" Text="Preparing update..." FontSize="15" FontWeight="SemiBold" />
            <ProgressBar Grid.Row="4" x:Name="Progress" Height="7" IsIndeterminate="True" Foreground="#75C018" Background="#222929" BorderThickness="0" />
            <StackPanel Grid.Row="5" VerticalAlignment="Bottom"><TextBlock x:Name="DetailText" Text="Please keep this window open." Foreground="#B9C4C5" FontSize="11" /><Button x:Name="CloseButton" Content="Close" Width="82" Height="32" HorizontalAlignment="Right" Margin="0,14,0,0" Visibility="Collapsed" Click="CloseButtonClick" /></StackPanel>
        </Grid>
    </Border>
</Window>
